---
// src/components/nav/LanguageSwitcher.astro
---

<div class="language-switcher">
    <button
        type="button"
        class="language-switcher__toggle"
        aria-expanded="false"
        aria-haspopup="listbox"
    >
        EN <span class="language-switcher__caret" aria-hidden="true">⌄</span>
    </button>
    <ul class="language-switcher__list" role="listbox">
        <li
            class="language-switcher__option"
            role="option"
            aria-selected="true"
        >
            <button type="button" class="language-switcher__option-btn"
                >EN</button
            >
        </li>
        <li
            class="language-switcher__option"
            role="option"
            aria-selected="false"
        >
            <button type="button" class="language-switcher__option-btn"
                >FR</button
            >
        </li>
        <li
            class="language-switcher__option"
            role="option"
            aria-selected="false"
        >
            <button type="button" class="language-switcher__option-btn"
                >NL</button
            >
        </li>
    </ul>
</div>

<style>
    .language-switcher {
        display: flex;
        align-items: center;
    }

    /* Mobile default: no dropdown toggle, list always visible in a row */
    .language-switcher__toggle {
        display: none;
    }

    .language-switcher__list {
        display: flex;
        gap: 1rem;
        list-style: none;
    }

    .language-switcher__option[aria-selected="true"]
        .language-switcher__option-btn {
        font-weight: var(--weight-bold);
        text-decoration: underline;
    }

    .language-switcher__option-btn {
        font-weight: var(--weight-regular);
        cursor: pointer;
        color: inherit;
        background: none;
        border: none;
    }

    /* Desktop: dropdown mode */
    @media (min-width: 768px) {
        .language-switcher {
            position: relative;
        }

        .language-switcher__toggle {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
        }

        .language-switcher__list {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            flex-direction: column;
            gap: 0;
            min-width: 100%;
            background: #fff;
            border: 1px solid var(--color-lines, #000);
            padding: 0;
            margin-top: 0.75rem;
            z-index: 30;
        }

        .language-switcher__list.language-switcher__list--open {
            display: flex;
        }

        .language-switcher__option {
            border-bottom: 1px solid var(--color-lines, #000);
        }

        .language-switcher__option:last-child {
            border-bottom: none;
        }

        .language-switcher__option-btn {
            display: block;
            width: 100%;
            padding: 0.5rem 1rem;
            text-align: left;
        }
    }
</style>

<script>
    const languageSwitchers =
        document.querySelectorAll<HTMLDivElement>(".language-switcher");

    languageSwitchers.forEach((languageSwitcher) => {
        const languageToggle =
            languageSwitcher.querySelector<HTMLButtonElement>(
                ".language-switcher__toggle",
            );
        const languageList = languageSwitcher.querySelector<HTMLUListElement>(
            ".language-switcher__list",
        );

        languageToggle?.addEventListener("click", () => {
            const isExpanded =
                languageToggle.getAttribute("aria-expanded") === "true";
            const nextExpanded = !isExpanded;

            languageToggle.setAttribute("aria-expanded", String(nextExpanded));
            languageList?.classList.toggle(
                "language-switcher__list--open",
                nextExpanded,
            );
        });
    });
</script>

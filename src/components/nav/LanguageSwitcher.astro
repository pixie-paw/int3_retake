---
// src/components/nav/LanguageSwitcher.astro
---

<div class="language-switcher">
    <button
        type="button"
        class="language-switcher__toggle"
        aria-expanded="false"
        aria-haspopup="listbox"
    >
        EN <span class="language-switcher__caret" aria-hidden="true">⌄</span>
    </button>
    <ul class="language-switcher__list" role="listbox">
        <li
            class="language-switcher__option"
            role="option"
            aria-selected="true"
        >
            <button type="button" class="language-switcher__option-btn"
                >EN</button
            >
        </li>
        <li
            class="language-switcher__option"
            role="option"
            aria-selected="false"
        >
            <button type="button" class="language-switcher__option-btn"
                >FR</button
            >
        </li>
        <li
            class="language-switcher__option"
            role="option"
            aria-selected="false"
        >
            <button type="button" class="language-switcher__option-btn"
                >NL</button
            >
        </li>
    </ul>
</div>

<style>
    .language-switcher {
        display: flex;
        align-items: center;
    }

    /* Mobile default: no dropdown toggle, list always visible in a row */
    .language-switcher__toggle {
        display: none;
    }

    .language-switcher__list {
        display: flex;
        gap: 1rem;
        list-style: none;
    }

    .language-switcher__option[aria-selected="true"]
        .language-switcher__option-btn {
        font-weight: var(--weight-bold);
        text-decoration: underline;
    }

    .language-switcher__option-btn {
        font-weight: var(--weight-regular);
        cursor: pointer;
        color: inherit;
        background: none;
        border: none;
    }
</style>

<script>
    const languageSwitchers =
        document.querySelectorAll<HTMLDivElement>(".language-switcher");

    languageSwitchers.forEach((languageSwitcher) => {
        const languageToggle =
            languageSwitcher.querySelector<HTMLButtonElement>(
                ".language-switcher__toggle",
            );
        const languageList = languageSwitcher.querySelector<HTMLUListElement>(
            ".language-switcher__list",
        );

        languageToggle?.addEventListener("click", () => {
            const isExpanded =
                languageToggle.getAttribute("aria-expanded") === "true";
            const nextExpanded = !isExpanded;

            languageToggle.setAttribute("aria-expanded", String(nextExpanded));
            languageList?.classList.toggle(
                "language-switcher__list--open",
                nextExpanded,
            );
        });
    });
</script>

---
// src/components/nav/MobileMenuToggle.astro
---

<button
    type="button"
    class="mobile-menu-toggle__btn"
    data-open="false"
    aria-expanded="false"
    aria-controls="mobile-menu-dialog"
    aria-label="Open menu"
>
    <svg
        class="mobile-menu-toggle__icon mobile-menu-toggle__icon--open"
        width="27"
        height="17"
        viewBox="0 0 27 17"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
    >
        <line
            x1="1.09278e-07"
            y1="15.25"
            x2="27"
            y2="15.25"
            stroke="currentColor"
            stroke-width="2.5"></line>
        <line
            x1="1.09278e-07"
            y1="8.25"
            x2="27"
            y2="8.25"
            stroke="currentColor"
            stroke-width="2.5"></line>
        <line
            x1="1.09278e-07"
            y1="1.25"
            x2="27"
            y2="1.25"
            stroke="currentColor"
            stroke-width="2.5"></line>
    </svg>
    <svg
        class="mobile-menu-toggle__icon mobile-menu-toggle__icon--close"
        width="23"
        height="24"
        viewBox="0 0 23 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
    >
        <path
            d="M1.76562 1.76562L20.2656 21.7656M19.2656 1.76562L2.26562 21.7656"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="square"></path>
    </svg>
</button>

<dialog
    id="mobile-menu-dialog"
    class="mobile-menu-toggle__dialog"
    aria-label="Site menu"
>
    <div class="mobile-menu-toggle__content">
        <slot />
    </div>
</dialog>

<style>
    .mobile-menu-toggle__btn {
        color: var(--color-text-secondary, black);
    }

    .mobile-menu-toggle__icon--close {
        display: none;
    }
    .mobile-menu-toggle__btn[data-open="true"] .mobile-menu-toggle__icon--open {
        display: none;
    }
    .mobile-menu-toggle__btn[data-open="true"]
        .mobile-menu-toggle__icon--close {
        display: block;
    }

    .mobile-menu-toggle__dialog {
        position: fixed;
        top: var(--nav-height);
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: auto;
        max-width: 100%;
        max-height: calc(100% - var(--nav-height));
        margin: 0;
        padding: 0;
        border: none;
        background: var(--color-pink, pink);
    }

    .mobile-menu-toggle__dialog::backdrop {
        background: transparent;
    }

    .mobile-menu-toggle__content {
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
    }

    @media (min-width: 768px) {
        .mobile-menu-toggle__btn {
            display: none;
        }
    }
</style>

<script>
    const menuBtn = document.querySelector<HTMLButtonElement>(
        ".mobile-menu-toggle__btn",
    );
    const menuDialog = document.querySelector<HTMLDialogElement>(
        ".mobile-menu-toggle__dialog",
    );

    menuBtn?.addEventListener("click", () => {
        const isOpen = menuBtn.dataset.open === "true";
        const nextOpen = !isOpen;

        menuBtn.dataset.open = String(nextOpen);
        menuBtn.setAttribute("aria-expanded", String(nextOpen));
        menuBtn.setAttribute(
            "aria-label",
            nextOpen ? "Close menu" : "Open menu",
        );

        nextOpen ? menuDialog?.show() : menuDialog?.close();
    });

    menuDialog?.addEventListener("close", () => {
        menuBtn?.setAttribute("data-open", "false");
        menuBtn?.setAttribute("aria-expanded", "false");
        menuBtn?.setAttribute("aria-label", "Open menu");
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menuDialog?.open) {
            menuDialog.close();
        }
    });
</script>

---
// src/components/nav/SoundToggle.astro
---

<button
    type="button"
    class="sound-toggle"
    data-playing="false"
    aria-pressed="false"
    aria-label="Play video sound"
>
    <svg
        class="sound-toggle__icon sound-toggle__icon--on"
        width="25"
        height="20"
        viewBox="0 0 25 20"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
    >
        <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M21.1902 19.8985L19.2381 18.3473C23.5895 13.6248 23.5895 6.4054 19.238 1.68287L21.1902 0.131817C26.27 5.76519 26.2699 14.265 21.1902 19.8985ZM16.241 4.06414L14.2865 5.617C16.6205 8.09654 16.6205 11.9337 14.2866 14.4133L16.241 15.9661C19.3029 12.5748 19.3029 7.4554 16.241 4.06414ZM11.2462 0L4.74456 5.08105H0V15.0222H4.75183L11.2462 20V0Z"
            fill="currentColor"></path>
    </svg>
    <svg
        class="sound-toggle__icon sound-toggle__icon--off"
        width="28"
        height="23"
        viewBox="0 0 28 23"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
    >
        <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M23.9533 11.4177L27.91 15.3744L25.9067 17.3777L21.9501 13.421L17.9933 17.3777L15.9901 15.3744L19.9468 11.4177L15.9901 7.46101L17.9933 5.4578L21.9501 9.41448L25.9067 5.4578L27.91 7.46101L23.9533 11.4177ZM12.7334 0L5.372 5.79262H0V17.1259H5.38023L12.7334 22.8009V0Z"
            fill="currentColor"></path>
    </svg>
</button>

<style>
    .sound-toggle {
        color: var(--color-text-secondary, black);
    }

    .sound-toggle__icon--on {
        display: none;
    }
    .sound-toggle[data-playing="true"] .sound-toggle__icon--on {
        display: block;
    }
    .sound-toggle[data-playing="true"] .sound-toggle__icon--off {
        display: none;
    }
</style>

<script>
    const soundToggles =
        document.querySelectorAll<HTMLButtonElement>(".sound-toggle");

    soundToggles.forEach((soundToggle) => {
        soundToggle.addEventListener("click", () => {
            const isPlaying = soundToggle.dataset.playing === "true";
            const nextPlaying = !isPlaying;

            soundToggle.dataset.playing = String(nextPlaying);
            soundToggle.setAttribute("aria-pressed", String(nextPlaying));
            soundToggle.setAttribute(
                "aria-label",
                nextPlaying ? "Mute video sound" : "Play video sound",
            );

            // TODO: dispatch a custom event here once the YouTube section exists
        });
    });
</script>

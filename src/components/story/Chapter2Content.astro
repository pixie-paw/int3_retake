---
import { getImage } from "astro:assets";
import titleCh2Url from "../../assets/chapter2/title_ch2.svg?url";
import tapeLukasUrl from "../../assets/chapter2/titleCh02_01.png?url";
import margielaSrc from "../../assets/chapter2/martin_margiela.png";
import flowerSrc from "../../assets/intro/pink_flower.png";
import InfoReveal from "./InfoReveal.astro";
import tapeWorldUrl from "../../assets/chapter2/titleCh02_02.png?url";
import vivBowieSrc from "../../assets/chapter2/viv_bowie.png";
import tapeAcademyUrl from "../../assets/chapter2/titleCh02_03.png?url";
import flowersPinkSrc from "../../assets/chapter2/flowers_pink.png";
import tapeRadiatedUrl from "../../assets/chapter2/titleCh02_04.png?url";
import tapeOutspokenUrl from "../../assets/chapter2/titleCh02_05.png?url";
import ladiladilaSrc from "../../assets/chapter2/ladiladila.png";
import doitSrc from "../../assets/chapter2/doit.png";
import laceLeftSrc from "../../assets/chapter2/lace_left.png";
import laceRightSrc from "../../assets/chapter2/lace_right.png";

const margiela = await getImage({ src: margielaSrc, format: "webp" });
const flower = await getImage({ src: flowerSrc, format: "webp" });
const vivBowie = await getImage({ src: vivBowieSrc, format: "webp" });
const flowersPink = await getImage({ src: flowersPinkSrc, format: "webp" });
const ladiladila = await getImage({ src: ladiladilaSrc, format: "webp" });
const doit = await getImage({ src: doitSrc, format: "webp" });
const laceLeft = await getImage({ src: laceLeftSrc, format: "webp" });
const laceRight = await getImage({ src: laceRightSrc, format: "webp" });
---

<div class="chapter2">
    <img
        src={laceLeft.src}
        alt=""
        aria-hidden="true"
        class="chapter2__lace chapter2__lace--left"
    />
    <img
        src={laceRight.src}
        alt=""
        aria-hidden="true"
        class="chapter2__lace chapter2__lace--right"
    />

    <div class="chapter2__header">
        <p class="chapter2__eyebrow">Chapter 2</p>

        <div class="chapter2__title-wrap" data-reveal>
            <img
                src={titleCh2Url}
                alt=""
                aria-hidden="true"
                class="chapter2__title-img"
            />
            <h2 class="visually-hidden">Formative Years</h2>
        </div>

        <img
            src={flower.src}
            alt=""
            aria-hidden="true"
            class="chapter2__flower"
        />
    </div>

    <div class="chapter2__lukas-wrap" data-reveal>
        <section class="chapter2__block chapter2__block--lukas">
            <div class="chapter2__label-wrap">
                <img
                    src={tapeLukasUrl}
                    alt=""
                    aria-hidden="true"
                    class="chapter2__label-img"
                />
                <h3 class="visually-hidden">
                    St. Lukas Institute of Fine Arts and Martin Margiela
                </h3>
            </div>

            <p class="chapter2__paragraph chapter2__paragraph--first">
                By fifteen, Marina's world was beginning to open up beyond the
                one she had created at home. She enrolled at the St. Lukas
                Institute of Fine Arts in Hasselt, bringing the interests she
                had explored mostly on her own into the art school.
            </p>

            <img
                src={margiela.src}
                alt=""
                aria-hidden="true"
                class="chapter2__margiela"
            />

            <p class="chapter2__paragraph chapter2__paragraph--second">
                Here, her distinctive way of dressing caught the attention of
                Martin Margiela, another soon to be famous fashion designer. He
                was drawn to what he called Marina's "crazy combinations", and
                the two quickly became close because of their shared fascination
                with clothing and art. For Marina, this was also the beginning
                of a new kind of creative companionship — she now had someone
                with whom she could exchange ideas instead of exploring them
                entirely on her own.
            </p>
        </section>

        <div class="chapter2__quote-wrap" data-reveal>
            <blockquote class="chapter2__quote">
                <span
                    class="chapter2__quote-mark chapter2__quote-mark--open"
                    aria-hidden="true">"</span
                >
                <p class="chapter2__quote-text">
                    He loved my weird combinations. He thought they were
                    fantastic. And so we had something in common, a shared
                    passion for fashion and clothes.
                </p>
                <span
                    class="chapter2__quote-mark chapter2__quote-mark--close"
                    aria-hidden="true">"</span
                >
            </blockquote>
            <p class="chapter2__quote-attribution">— Marina Yee</p>
        </div>
    </div>

    <section class="chapter2__block chapter2__block--world" data-reveal>
        <div class="chapter2__world-info-wrap">
            <InfoReveal
                id="world-info-panel"
                label="Some cultural context"
                facts={[
                    {
                        title: "Some cultural context",
                        text: `By the 1970s, David Bowie turned clothing, makeup and image into an essential part of performance, working with designers such as Kansai Yamamoto to create identities that could change from one appearance to the next. In London, punk pushed things even further. Vivienne Westwood and Malcolm McLaren brought music and clothing together around a scene that lived in shops, clubs and on the street rather than inside traditional couture.`,
                    },
                ]}
            >
                <div class="chapter2__label-wrap">
                    <img
                        src={tapeWorldUrl}
                        alt=""
                        aria-hidden="true"
                        class="chapter2__label-img--world"
                    />
                    <h3 class="visually-hidden">The world around</h3>
                </div>
                <p class="chapter2__paragraph">
                    At the same time, the world around Marina was changing too.
                    The spirit of the late 1960s had pushed a younger generation
                    to question the values and rules they had inherited, and
                    that rebellion soon found its way into art, music and
                    fashion. For young creatives, inspiration was no longer
                    coming from the established fashion houses of Paris or
                    Milan.
                </p>
            </InfoReveal>
            <a
                href="https://heron.libis.be/momu/s/studiecollectie/page/mode1980"
                target="_blank"
                rel="noopener noreferrer"
                class="chapter2__link">Learn more about fashion in the '80s</a
            >
        </div>
        <img
            src={vivBowie.src}
            alt=""
            aria-hidden="true"
            class="chapter2__viv-bowie"
        />
    </section>

    <section class="chapter2__block chapter2__block--academy" data-reveal>
        <img
            src={flowersPink.src}
            alt=""
            aria-hidden="true"
            class="chapter2__academy-flowers"
        />

        <div class="chapter2__academy-info-wrap">
            <InfoReveal
                id="academy-info-panel"
                label="The Academy between 1963 to 1985"
                facts={[
                    {
                        title: "The Academy between 1963 to 1985",
                        text: `The fashion department from the Academy was founded in 1963 under Mary Prijot and Marthe Van Leemput. The department placed a strong emphasis on drawing, technique, elegance and good taste. Prijot admired Chanel and believed clothes should follow certain rules of propriety — even knees and elbows were considered better left covered. Former students later remembered the teaching as fairly old-school.`,
                    },
                ]}
            >
                <div class="chapter2__academy-inner">
                    <div class="chapter2__label-wrap">
                        <img
                            src={tapeAcademyUrl}
                            alt=""
                            aria-hidden="true"
                            class="chapter2__label-img"
                        />
                        <h3 class="visually-hidden">
                            Royal Academy of Fine Arts
                        </h3>
                    </div>

                    <p class="chapter2__paragraph">
                        When Marina joined Martin at the Fashion Department of
                        the Royal Academy of Fine Arts in Antwerp, her creative
                        circle grew even more. She studied alongside Ann
                        Demeulemeester, Dirk Van Saene, Dirk Bikkembergs and
                        Dries Van Noten, while Martin and Walter Van Beirendonck
                        were a year ahead. After years of exploring mostly on
                        her own, Marina was now surrounded by people who were
                        just as absorbed in fashion, arts, music and new ideas
                        just as she was.
                    </p>
                </div>
            </InfoReveal>
        </div>
    </section>

    <section class="chapter2__block chapter2__block--fashion" data-reveal>
        <div class="chapter2__fashion-label1">
            <img
                src={tapeRadiatedUrl}
                alt=""
                aria-hidden="true"
                class="chapter2__label-img--fashion"
            />
            <h3 class="visually-hidden">She "radiated fashion"</h3>
        </div>

        <p class="chapter2__fashion-para1 chapter2__paragraph">
            Fashion seemed to come naturally to Marina, not only through what
            she created, but through the way she carried herself. People who
            knew her at the time remembered that she simply "radiated fashion".
            Dirk Bikkembergs later recalled arriving at the Academy for his
            entrance exam and seeing Marina moving quickly through the corridor
            in a huge white parachute parka. As she walked, the coat caught the
            air and billowed around her, The image was so striking that
            Bikkembergs said that this encounter convinced him to study fashion.
        </p>

        <div class="chapter2__fashion-visual">
            <img
                src={ladiladila.src}
                alt=""
                aria-hidden="true"
                class="chapter2__ladiladila-img"
                data-magnify
            />
        </div>

        <div class="chapter2__fashion-label2">
            <img
                src={tapeOutspokenUrl}
                alt=""
                aria-hidden="true"
                class="chapter2__label-img chapter2__label-img--bold"
            />
            <h3 class="visually-hidden">Outspoken, opinionated, and bold</h3>
        </div>

        <p class="chapter2__fashion-para2 chapter2__paragraph">
            That same confidence was also present in the way Marina spoke about
            their future. She later remembered herself in those years as
            outspoken, opinionated and bold. When the group began wondering
            whether designers from Belgium could ever become known
            internationally, Martin doubted they could, but Marina already
            believed they could make their way beyond Belgium.
        </p>

        <div class="chapter2__fashion-quote">
            <img
                src={doit.src}
                alt=""
                aria-hidden="true"
                class="chapter2__doit-img"
            />
            <blockquote class="visually-hidden">
                <p>
                    Yes, we can do it. If those other designers can do it, so
                    can we.
                </p>
            </blockquote>
            <p class="visually-hidden">— Marina Yee</p>
        </div>
    </section>
</div>

<style>
    .chapter2__lace {
        display: none;
    }

    /* Martin section */
    .chapter2 {
        position: relative;
        padding: 4rem 1.5rem;
    }

    .chapter2__header {
        position: relative;
    }

    .chapter2__flower {
        display: none;
    }

    .chapter2__eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-family: var(--font-family-serif);
        font-weight: var(--weight-bold);
        color: var(--color-text-main);
        margin-bottom: 0.5rem;
    }

    .chapter2__title-img {
        display: block;
        width: 100%;
        max-width: 23rem;
        height: auto;
        margin-bottom: 4rem;
    }

    .chapter2__lukas-wrap {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        justify-content: center;
        align-items: center;
    }

    .chapter2__block--lukas {
        display: grid;
        grid-template-areas:
            "label"
            "para1"
            "image"
            "para2";
        justify-items: center;
    }

    .chapter2__label-wrap {
        grid-area: label;
        justify-self: center;
    }

    .chapter2__paragraph--first {
        grid-area: para1;
    }

    .chapter2__margiela {
        grid-area: image;
        display: block;
        width: 100%;
        max-width: 20rem;
        height: auto;
        margin-inline: auto;
    }

    .chapter2__paragraph--second {
        grid-area: para2;
    }

    .chapter2__label-img {
        display: block;
        width: 100%;
        height: auto;
        max-width: 20rem;
        margin-bottom: 1rem;
        margin-inline: auto;
    }

    .chapter2__paragraph {
        font-size: var(--step-0);
        color: var(--color-text-main);
        text-align: justify;
    }

    .chapter2__quote-mark {
        display: block;
        font-family: var(--font-family-punktype);
        font-weight: var(--weight-black, 900);
        font-size: 5rem;
        line-height: 1;
        color: var(--color-text-main);
    }

    .chapter2__quote-mark--close {
        text-align: right;
    }

    .chapter2__quote-text {
        font-family: var(--font-family-bestieseventy);
        font-size: var(--step-4);
        line-height: 2rem;
        color: var(--color-text-main);
        letter-spacing: 0.02em;
        text-align: center;
    }

    .chapter2__quote-attribution {
        text-align: right;
        font-family: var(--font-family-bestieseventy);
        font-size: var(--step-4);
        letter-spacing: 0.02em;
        color: var(--color-text-main);
        margin-top: 1rem;
    }

    /* World around section */
    .chapter2__label-img--world {
        width: 100%;
        height: auto;
        max-width: 18rem;
        margin-inline: auto;
        padding-bottom: 1rem;
    }

    .chapter2__block--world {
        display: grid;
        grid-template-areas:
            "info"
            "photo";
        gap: 2rem;
        padding-top: 3rem;
        justify-items: center;
    }

    .chapter2__world-info-wrap {
        grid-area: info;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .chapter2__link {
        text-decoration: underline;
        font-family: var(--font-family-sans);
        color: var(--color-text-secondary);
        font-size: var(--step-2);
    }

    .chapter2__viv-bowie {
        grid-area: photo;
        display: block;
        width: 100vw;
        max-width: none;
        height: auto;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
    }

    /* Academy section */
    .chapter2__academy-flowers {
        display: none;
    }

    .chapter2__academy-info-wrap {
        max-width: 30rem;
    }

    .chapter2__academy-inner {
        display: grid;
        grid-template-areas:
            "label"
            "para";
    }

    .chapter2__academy-inner .chapter2__label-wrap {
        grid-area: label;
        justify-self: center;
    }

    .chapter2__academy-inner .chapter2__paragraph {
        grid-area: para;
        justify-self: start;
    }

    .chapter2__block--academy {
        position: relative;
        margin-top: 3rem;
    }

    /* Fashion section */
    .chapter2__label-img--fashion {
        width: 100%;
        height: auto;
        max-width: 18rem;
        margin-inline: auto;
        padding-bottom: 1rem;
    }

    .chapter2__block--fashion {
        display: grid;
        grid-template-areas:
            "label1"
            "para1"
            "visual"
            "label2"
            "para2"
            "quote";
        margin-top: 5rem;
    }

    .chapter2__fashion-label1 {
        grid-area: label1;
    }

    .chapter2__fashion-para1 {
        grid-area: para1;
    }

    .chapter2__fashion-visual {
        grid-area: visual;
    }

    .chapter2__fashion-label2 {
        grid-area: label2;
    }

    .chapter2__fashion-para2 {
        grid-area: para2;
    }

    .chapter2__fashion-quote {
        grid-area: quote;
    }

    .chapter2__ladiladila-img {
        display: block;
        width: 100vw;
        max-width: none;
        height: auto;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        padding-block: 2rem;
    }

    .chapter2__doit-img {
        display: block;
        width: 100vw;
        max-width: none;
        height: auto;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        padding-block: 2rem;
    }

    @media (min-width: 48rem) {
        .chapter2__lace {
            display: block;
            position: absolute;
            /* width: 80px; */
            height: auto;
            object-fit: contain;
            pointer-events: none;
        }

        .chapter2__lace--left {
            left: 0;
            top: 0; /* adjust once you see where it should start */
        }

        .chapter2__lace--right {
            right: 0;
            top: 65rem;
            z-index: -1;
        }

        /* Martin section */
        .chapter2 {
            padding: 2rem 6rem;
        }

        .chapter2__flower {
            display: block;
            position: absolute;
            top: 7rem;
            right: 8rem;
            width: 6rem;
            height: auto;
            object-fit: contain;
            pointer-events: none;
            z-index: -1;
        }

        .chapter2__title-img {
            max-width: 60rem;
        }

        .chapter2__block--lukas {
            display: grid;
            width: 100%;
            grid-template-columns: 1fr 0.5fr;
            grid-template-areas:
                "image label"
                "image para1"
                "image para2";
            justify-content: center;
            grid-template-rows: 9rem 8rem 11rem;
            grid-template-columns: 1fr 1fr;
        }

        .chapter2__margiela {
            width: 100%;
            height: auto;
            max-width: 35rem;
            margin-inline: 0;
        }

        .chapter2__label-img {
            max-width: 22rem;
        }

        .chapter2__paragraph {
            width: 100%;
            max-width: 32rem;
        }

        .chapter2__quote-wrap {
            width: 100%;
            height: auto;
            max-width: 68rem;
            margin-top: 10rem;
            justify-content: center;
        }

        .chapter2__quote-mark {
            font-size: 7rem;
        }

        .chapter2__quote-text {
            text-align: left;
            line-height: 2.5rem;
        }

        /* World around section */
        .chapter2__block--world {
            grid-template-columns: minmax(18rem, 30rem) 1fr;
            grid-template-areas: "info photo";
            align-items: start;
            gap: 3rem;
        }

        .chapter2__viv-bowie {
            width: clamp(28rem, 45vw, 47rem);
            max-width: none;
            margin-left: 0;
            margin-right: 0;
        }

        /* Academy section */
        .chapter2__academy-flowers {
            display: block;
            position: absolute;
            top: 14rem;
            right: 22rem;
            width: 24rem;
            height: auto;
            object-fit: contain;
            pointer-events: none;
            z-index: -1;
        }

        .chapter2__block--academy {
            margin-top: -14rem;
        }

        /* Fashion section */
        .chapter2__block--fashion {
            grid-template-columns: minmax(30rem, 1fr) minmax(30rem, 1fr);
            grid-template-areas:
                "visual label1"
                "visual para1"
                "visual label2"
                "visual para2"
                "quote  quote";
            align-items: center;
            justify-items: center;
            margin-top: 7rem;
        }

        .chapter2__ladiladila-img {
            width: clamp(28rem, 55vw, 47rem);
            max-width: none;
            margin-left: -4rem;
            margin-right: 0;
        }

        .chapter2__doit-img {
            width: 100%;
            height: auto;
            max-width: 47rem;
            margin-inline: auto;
        }

        .chapter2__label-img--bold {
            margin-top: 3rem;
        }
    }
</style>

<script>
    import { initScrollReveal } from "../../scripts/scrollReveal";
    import { initMagnifier } from "../../scripts/Magnifier";

    initScrollReveal();
    initMagnifier();
</script>

---
import { getImage } from "astro:assets";
import titleCh3Url from "../../assets/chapter3/title_ch3.svg?url";
import tapeLondonUrl from "../../assets/chapter3/titleCh03_01.png?url";
import londonSrc from "../../assets/chapter3/london.png";
import flowersPinkSrc from "../../assets/chapter3/flowers_pink.png";
import tapeSuccessUrl from "../../assets/chapter3/titleCh03_02.png?url";
import workshopSrc from "../../assets/chapter3/workshop.png";
import tapeNotReadyUrl from "../../assets/chapter3/titleCh03_03.png?url";
import fittingUrl from "../../assets/chapter3/fitting.svg?url";
import tapeCherryUrl from "../../assets/chapter3/titleCh03_04.png?url";
import museSrc from "../../assets/chapter3/muse.png";
import InfoReveal from "./InfoReveal.astro";

const london = await getImage({ src: londonSrc, format: "webp" });
const flowersPink = await getImage({ src: flowersPinkSrc, format: "webp" });
const workshop = await getImage({ src: workshopSrc, format: "webp" });
const muse = await getImage({ src: museSrc, format: "webp" });
---

<div class="chapter3">
    <div class="chapter3__header">
        <p class="chapter3__eyebrow">Chapter 3</p>

        <div class="chapter3__title-wrap">
            <img
                src={titleCh3Url}
                alt="Image that represents visually the title of chapter 3, Momentum. The image is a stylized representation of the word 'Momentum' in a combination of fonts, looking like a collage."
                aria-hidden="true"
                class="chapter3__title-img"
            />
            <h2 class="visually-hidden">Momentum</h2>
        </div>
    </div>

    <section class="chapter3__block chapter3__block--london">
        <img
            src={flowersPink.src}
            alt="Pink ornamental flowers that are part of the chapter 3 design."
            aria-hidden="true"
            class="chapter3__flowers"
        />

        <div class="chapter3__london-info-wrap">
            <InfoReveal
                id="london-info-panel"
                label="London and the birth of Antwerp Six"
                facts={[
                    {
                        title: "The British Designer Show",
                        text: "The British Designer Show was the original name for London Fashion Week, and it launched in March 1984 at Olympia in London as a pioneering trade exhibition and catwalk showcase.",
                    },
                    {
                        title: "The Antwerp Six didn't chose their group name",
                        text: `Their Flemish surnames were difficult for the international journalists and buyers to pronounce. Fashion journalist Tim Blanks later recalled that people simply began referring to them as "the six from Antwerp." The shorthand spread through the press and buying community, the buzz grew, and before long, the Antwerp Six was born.`,
                    },
                ]}
            >
                <div class="chapter3__label-wrap">
                    <img
                        src={tapeLondonUrl}
                        alt="Image that visually represents the subtitle of this chapter. The image shows letters on some pieces of torn paper."
                        aria-hidden="true"
                        class="chapter3__label-img"
                    />
                    <h3 class="visually-hidden">
                        London and the birth of Antwerp Six
                    </h3>
                </div>

                <p class="chapter3__paragraph">
                    In 1986, together with Ann Demeulemeester, Dirk Bikkembergs,
                    Dries Van Noten, Dirk Van Saene and Walter Van Beirendonck,
                    Marina travelled to London to present at the British
                    Designer Show. What began as a group of young designers from
                    Antwerp suddenly caught international attention, and the six
                    would soon become known as the Antwerp Six. The world
                    outside Belgium was beginning to notice what they had been
                    building together.
                </p>
            </InfoReveal>
        </div>

        <img
            src={london.src}
            alt="A collage image with the whole group of Antwerp Six designers, walking in front of the Big Ben in London. The designers are Marina Yee, Ann Demeulemeester, Dirk Bikkembergs, Dries Van Noten, Dirk Van Saene and Walter Van Beirendonck."
            aria-hidden="true"
            class="chapter3__london-img"
        />

        <a
            href="https://www.momu.be/en"
            target="_blank"
            rel="noopener noreferrer"
            class="chapter3__link"
        >
            Learn more about the Antwerp Six at MoMu
        </a>
    </section>

    <section class="chapter3__block chapter3__block--success">
        <div class="chapter3__success-taste-top">
            <div class="chapter3__label-wrap">
                <img
                    src={tapeSuccessUrl}
                    alt="This is an image that visually represents the subtitle of this chapter. The image shows letters on some pieces of torn paper."
                    aria-hidden="true"
                    class="chapter3__label-img chapter3__label-img--success"
                />
                <h3 class="visually-hidden">Taste of success</h3>
            </div>

            <p class="chapter3__paragraph">
                Success brought more than attention, and opportunities began
                arriving quickly: magazines wanted to feature them,
                manufacturers were interested in producing their collections,
                and Marina's own career began to grow beyond the small,
                experimental world she had known before. She worked for Belgian
                brands, received financial backing and started developing work
                under her own name.
            </p>
        </div>

        <img
            src={workshop.src}
            alt="This collage combines 2 pieces of Marina's work, together with part of one of her fashion shows invitation."
            aria-hidden="true"
            class="chapter3__workshop-img"
        />

        <p class="chapter3__paragraph chapter3__success-para2">
            What had once been driven mostly by instinct and curiosity was now
            entering a much larger system, one that was built around
            collections, production, shops and the expectation to keep on
            growing.
        </p>

        <div class="chapter3__notready-wrap">
            <div class="chapter3__label-wrap">
                <img
                    src={tapeNotReadyUrl}
                    alt="This is an image that visually represents the subtitle of this chapter. The image shows letters on some pieces of torn paper."
                    aria-hidden="true"
                    class="chapter3__label-img chapter3__label-img--notready"
                />
                <h3 class="visually-hidden">She was not ready</h3>
            </div>

            <p class="chapter3__paragraph">
                Marina began questioning whether she could picture herself in
                how her new life was starting to look. She later admitted that
                she struggled with the expectations that came with it. She
                missed appointments, kept people waiting and felt increasingly
                bad about the way she was functioning. Looking back, she simply
                described herself as: "not ready". More than the business
                itself, Marina was beginning to question:
            </p>
        </div>

        <img
            src={fittingUrl}
            alt="Was she even fitting in fashion at all?"
            class="chapter3__fitting-img"
        />
    </section>

    <section class="chapter3__block chapter3__block--muse">
        <div class="chapter3__cherry-top">
            <div class="chapter3__label-wrap">
                <img
                    src={tapeCherryUrl}
                    alt="Image that visually represents the subtitle of this chapter. The image shows letters on some pieces of torn paper."
                    aria-hidden="true"
                    class="chapter3__label-img chapter3__label-img--cherry"
                />
                <h3 class="visually-hidden">The cherry on the top</h3>
            </div>

            <p class="chapter3__paragraph">
                At the same time, Marina's relationship with Martin Margiela was
                adding more uncertainty to what she was already feeling. As his
                career in Paris was taking shape, elements of Marina's own way
                of dressing and altering clothes — the cutting, layering, her
                hair and makeup — were visible in Margiela's work.
            </p>
        </div>

        <img
            src={muse.src}
            alt="A collage with Marina Yee and flowers that reads 'She became his muse'"
            class="chapter3__muse-img"
        />

        <p class="chapter3__paragraph chapter3__cherry-para2">
            What might have looked from the outside like something that a young
            woman might dream of, only made the question of her own identity
            more difficult: if she was becoming part of someone else's creative
            expression, where did that leave room for her own? This made her
            want to find the creative voice that was entirely her own even more.
        </p>
    </section>
</div>

<style>
    .chapter3 {
        position: relative;
        padding: 0 1.5rem;
    }

    .chapter3__eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-family: var(--font-family-serif);
        font-weight: var(--weight-bold);
        color: var(--color-text-main);
        margin-bottom: 0.5rem;
    }

    /* London and Antwerp Six section */
    .chapter3__title-img {
        display: block;
        width: 100%;
        max-width: 22rem;
        height: auto;
        margin-bottom: 3rem;
    }

    .chapter3__block--london {
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .chapter3__flowers {
        display: none;
    }

    .chapter3__london-info-wrap {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .chapter3__label-img {
        display: block;
        width: 100%;
        height: auto;
        max-width: 16rem;
        margin-bottom: 1rem;
    }

    .chapter3__paragraph {
        font-size: var(--step-0);
        color: var(--color-text-main);
        text-align: justify;
        max-width: 16rem;
    }

    .chapter3__london-img {
        display: block;
        width: 100%;
        max-width: 20rem;
        height: auto;
        margin-left: auto;
        margin-right: -1.5rem;
        position: relative;
        top: -20rem;
        z-index: -1;
    }

    .chapter3__link {
        text-decoration: underline;
        font-family: var(--font-family-sans);
        color: var(--color-text-secondary);
        font-size: var(--step-2);
        margin-top: -18rem;
    }

    /* Taste of success / She was not ready section */
    .chapter3__block--success {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding-top: 5rem;
    }

    .chapter3__block--success .chapter3__paragraph {
        max-width: none; /* overrides any narrower constraint the shared .chapter3__paragraph class might carry (e.g. from the London section) — these paragraphs should run full width to the section's own padding, like normal body text elsewhere */
    }

    .chapter3__block--success .chapter3__label-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .chapter3__label-img--success {
        max-width: 15rem;
    }

    .chapter3__label-img--notready {
        max-width: 15rem;
    }

    .chapter3__workshop-img {
        display: block;
        width: 100%;
        max-width: 24rem;
        height: auto;
        margin-inline: auto;
    }

    .chapter3__fitting-img {
        display: block;
        width: 100%;
        max-width: 24rem;
        height: auto;
        margin-inline: auto;
    }

    .chapter3__notready-wrap {
        margin-top: 3rem;
    }

    /* She became his muse / The cherry on the top */
    .chapter3__block--muse {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding-top: 5rem;
    }

    .chapter3__block--muse .chapter3__paragraph {
        max-width: none;
    }

    .chapter3__block--muse .chapter3__label-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .chapter3__label-img--cherry {
        max-width: 17rem;
    }

    .chapter3__muse-img {
        display: block;
        width: calc(100% + 1.5rem);
        max-width: 28rem;
        height: auto;
        margin-left: -1.5rem;
        margin-right: auto;
    }

    @media (min-width: 48rem) {
        .chapter3 {
            padding: 6rem;
        }

        .chapter3__title-img {
            width: 100%;
            height: auto;
            max-width: 58rem;
            margin-bottom: 4rem;
        }

        /* London and Antwerp Six section */
        .chapter3__block--london {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: auto auto;
            grid-template-areas:
                "info image"
                "link image";
            align-items: start;
        }

        .chapter3__flowers {
            display: block;
            position: absolute;
            right: 18rem;
            top: 8rem;
            width: 15rem;
            height: auto;
            z-index: -1;
            pointer-events: none;
        }

        .chapter3__london-info-wrap {
            grid-area: info;
            margin-left: 6rem;
        }

        .chapter3__label-img {
            max-width: 25.1rem;
            margin-bottom: 1.5rem;
        }

        .chapter3__paragraph {
            max-width: 30rem;
        }

        .chapter3__london-img {
            grid-area: image;
            position: static;
            width: 100%;
            max-width: 36rem;
            height: auto;
            margin: 0;
            justify-self: end;
            margin-top: -10rem;
        }

        .chapter3__link {
            grid-area: link;
            display: block;
            margin-top: 1rem;
            margin-left: 6rem;
        }

        /* Taste of success / She was not ready section */
        .chapter3__block--success {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: auto auto auto;
            grid-template-areas:
                "workshop taste-top"
                "notready taste-bottom"
                "notready fitting";
            column-gap: 3rem;
            row-gap: 1.5rem;
            align-items: start;
        }

        .chapter3__success-taste-top {
            grid-area: taste-top;
            margin-top: 16rem;
        }

        .chapter3__workshop-img {
            grid-area: workshop;
        }

        .chapter3__success-para2 {
            grid-area: taste-bottom;
            margin-top: -17rem;
        }

        .chapter3__notready-wrap {
            grid-area: notready;
            margin-top: 8rem;
        }

        .chapter3__fitting-img {
            grid-area: fitting;
            margin-top: -8rem;
        }

        .chapter3__block--success .chapter3__paragraph {
            max-width: 32rem;
            margin-inline: auto;
        }

        .chapter3__block--success .chapter3__label-wrap {
            align-items: center;
        }

        .chapter3__label-img--success {
            max-width: 23rem;
        }

        .chapter3__label-img--notready {
            max-width: 23rem;
        }

        .chapter3__workshop-img {
            max-width: 40rem;
        }

        .chapter3__fitting-img {
            max-width: 40rem;
        }

        /* She became his muse / The cherry on the top */
        .chapter3__block--muse {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: auto auto;
            grid-template-areas:
                "muse cherry-top"
                "muse cherry-bottom";
            /* column-gap: 3rem; */
            /* row-gap: 1.5rem; */
            align-items: start;
        }

        .chapter3__muse-img {
            grid-area: muse;
        }

        .chapter3__cherry-top {
            grid-area: cherry-top;
        }

        .chapter3__cherry-para2 {
            grid-area: cherry-bottom;
        }

        .chapter3__block--muse .chapter3__paragraph {
            max-width: 32rem;
            margin-inline: auto;
        }

        .chapter3__block--muse .chapter3__label-wrap {
            align-items: center;
        }

        .chapter3__label-img--cherry {
            max-width: 27rem;
            margin-top: 12rem;
        }

        .chapter3__muse-img {
            width: calc(100% + 6rem);
            max-width: 60rem;
            margin-left: -6rem;
            margin-top: -10rem;
        }
    }
</style>

---
import iconUrl from "../../assets/chapter2/know_more.png?url";

interface Fact {
    title: string;
    text: string;
}

interface Props {
    id: string;
    /** Accessible name for the toggle, e.g. "London and the birth of Antwerp Six" */
    label: string;
    /** One fact = old single-panel behaviour. Two+ = paginated. */
    facts: Fact[];
    /** Per-chapter icon override; defaults to the Ch2 hand icon. */
    icon?: ImageMetadata | string;
    /**
     * "stacked" (default): icon above content, panel drops down full-width
     * below the icon — the original Ch2 layout, used at every breakpoint.
     * "inline": from the 48rem breakpoint up, the icon sits beside the
     * content instead of above it, and the panel overlays the content
     * rather than the icon. Below 48rem, "inline" still renders "stacked" —
     * there's no separate mobile-inline mode.
     */
    layout?: "stacked" | "inline";
}

const { id, label, facts, icon = iconUrl, layout = "stacked" } = Astro.props;
const iconSrc = typeof icon === "string" ? icon : icon.src;
const isPaged = facts.length > 1;
---

<div class:list={["info-reveal", layout === "inline" && "info-reveal--inline"]}>
    <details class="info-reveal__details" id={id}>
        <summary class="info-reveal__toggle">
            <img
                src={iconSrc}
                alt=""
                aria-hidden="true"
                class="info-reveal__icon"
            />
            <span class="visually-hidden">Show more: {label}</span>
        </summary>

        <div class="info-reveal__panel">
            <button type="button" class="info-reveal__close" aria-label="Close">
                <svg
                    width="23"
                    height="24"
                    viewBox="0 0 23 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                >
                    <path
                        d="M1.76562 1.76562L20.2656 21.7656M19.2656 1.76562L2.26562 21.7656"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="square"></path>
                </svg>
            </button>

            {
                isPaged ? (
                    <fieldset class="info-reveal__pager">
                        <legend class="visually-hidden">{label} — facts</legend>

                        {facts.map((_, i) => (
                            <input
                                type="radio"
                                name={`${id}-page`}
                                id={`${id}-page${i + 1}`}
                                class="info-reveal__page-radio visually-hidden"
                                checked={i === 0}
                            />
                        ))}

                        <div class="info-reveal__pages">
                            {facts.map((fact, i) => (
                                <div
                                    class="info-reveal__page"
                                    data-page={i + 1}
                                >
                                    <h4 class="info-reveal__title">
                                        {fact.title}
                                    </h4>
                                    <p class="info-reveal__text">{fact.text}</p>

                                    <div class="info-reveal__pageNav">
                                        <label
                                            for={`${id}-page${i > 0 ? i : i + 1}`}
                                            class:list={[
                                                "info-reveal__arrow",
                                                "info-reveal__arrow--prev",
                                                i === 0 &&
                                                    "info-reveal__arrow--placeholder",
                                            ]}
                                            aria-hidden={
                                                i === 0 ? "true" : undefined
                                            }
                                            aria-label={
                                                i > 0
                                                    ? `Previous, page ${i} of ${facts.length}`
                                                    : undefined
                                            }
                                        >
                                            <svg
                                                width="49"
                                                height="12"
                                                viewBox="0 0 49 12"
                                                fill="none"
                                                xmlns="http://www.w3.org/2000/svg"
                                                aria-hidden="true"
                                            >
                                                <path
                                                    d="M0 5.77344L10 11.5469V-6.53267e-05L0 5.77344ZM9 5.77344V6.77344H49V5.77344V4.77344H9V5.77344Z"
                                                    fill="#202020"
                                                />
                                            </svg>
                                        </label>

                                        <span
                                            class="info-reveal__pageCount"
                                            aria-hidden="true"
                                        >
                                            {i + 1}/{facts.length}
                                        </span>

                                        <label
                                            for={`${id}-page${i < facts.length - 1 ? i + 2 : i + 1}`}
                                            class:list={[
                                                "info-reveal__arrow",
                                                "info-reveal__arrow--next",
                                                i === facts.length - 1 &&
                                                    "info-reveal__arrow--placeholder",
                                            ]}
                                            aria-hidden={
                                                i === facts.length - 1
                                                    ? "true"
                                                    : undefined
                                            }
                                            aria-label={
                                                i < facts.length - 1
                                                    ? `Next, page ${i + 2} of ${facts.length}`
                                                    : undefined
                                            }
                                        >
                                            <svg
                                                width="49"
                                                height="12"
                                                viewBox="0 0 49 12"
                                                fill="none"
                                                xmlns="http://www.w3.org/2000/svg"
                                                aria-hidden="true"
                                            >
                                                <path
                                                    d="M49 5.77344L39 11.5469V-6.53267e-05L49 5.77344ZM40 5.77344V6.77344H0V5.77344V4.77344H40V5.77344Z"
                                                    fill="#202020"
                                                />
                                            </svg>
                                        </label>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </fieldset>
                ) : (
                    <>
                        <h4 class="info-reveal__title">{facts[0].title}</h4>
                        <p class="info-reveal__text">{facts[0].text}</p>
                    </>
                )
            }
        </div>
    </details>

    <div class="info-reveal__content">
        <slot />
    </div>
</div>

<style>
    .info-reveal {
        position: relative;
        --info-reveal-panel-top: 4rem;
    }

    .info-reveal__details {
        display: block;
        width: 100%;
    }

    .info-reveal__toggle {
        display: inline-block;
        cursor: pointer;
        list-style: none;
    }

    .info-reveal__toggle::-webkit-details-marker {
        display: none;
    }

    .info-reveal__icon {
        display: block;
        width: 7rem;
        height: auto;
        animation: info-reveal-float 3s ease-in-out infinite;
    }

    @keyframes info-reveal-float {
        0%,
        100% {
            transform: translateY(0) rotate(-3deg);
        }
        50% {
            transform: translateY(-8px) rotate(3deg);
        }
    }

    .info-reveal__details[open] .info-reveal__icon {
        animation: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .info-reveal__icon {
            animation: none;
        }
    }

    .info-reveal__content {
        position: relative;
        z-index: 1;
        padding-top: 1rem;
    }

    .info-reveal__details[open] ~ .info-reveal__content {
        visibility: hidden;
    }

    .info-reveal__panel {
        position: absolute;
        top: var(--info-reveal-panel-top);
        left: 0;
        right: 0;
        /* bottom: 0; */
        background: var(--color-pink, pink);
        padding: 1.5rem;
        z-index: 2;
        display: flex;
        flex-direction: column;
    }

    .info-reveal__close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: none;
        border: none;
        cursor: pointer;
        color: var(--color-text-main);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .info-reveal__title {
        font-family: var(--font-family-serif);
        font-size: var(--step-5);
        font-weight: var(--weight-bold);
        text-wrap: wrap;
        color: var(--color-text-main);
        padding-bottom: 1.5rem;
        margin-top: 5rem;
    }

    .info-reveal__text {
        font-family: var(--font-family-sans);
        font-size: var(--step-6);
        color: var(--color-text-main);
        text-align: justify;
        padding-bottom: 1.5rem;
    }

    /* --- Pagination (JS-free) --- */

    .info-reveal__pager {
        border: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
    }

    .info-reveal__pages {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
    }

    .info-reveal__page {
        display: none;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
    }

    .info-reveal__page-radio:nth-of-type(1):checked
        ~ .info-reveal__pages
        [data-page="1"],
    .info-reveal__page-radio:nth-of-type(2):checked
        ~ .info-reveal__pages
        [data-page="2"],
    .info-reveal__page-radio:nth-of-type(3):checked
        ~ .info-reveal__pages
        [data-page="3"],
    .info-reveal__page-radio:nth-of-type(4):checked
        ~ .info-reveal__pages
        [data-page="4"] {
        display: flex;
    }

    .info-reveal__pageNav {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: auto;
        justify-content: center;
    }

    .info-reveal__arrow {
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        color: var(--color-text-main);
    }

    .info-reveal__arrow:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 2px;
    }

    .info-reveal__arrow--placeholder {
        visibility: hidden; /* keeps the space reserved (unlike display:none) so the count stays centered at the same spot on every page */
        pointer-events: none;
        cursor: default;
    }

    .info-reveal__pageCount {
        font-family: var(--font-family-sans);
        font-size: var(--step-6);
        color: var(--color-text-main);
    }

    @media (min-width: 48rem) {
        .info-reveal__icon {
            width: 9rem;
        }

        .info-reveal--inline {
            --info-reveal-icon-offset: 10.5rem;
            display: flex;
            align-items: flex-start;
            gap: 1.5rem;
        }

        .info-reveal--inline .info-reveal__details {
            position: static;
            width: auto;
            flex: 0 0 auto;
        }

        .info-reveal--inline .info-reveal__content {
            flex: 1 1 auto;
            min-width: 0;
            padding-top: 0;
        }

        .info-reveal--inline .info-reveal__panel {
            top: 0;
            left: var(--info-reveal-icon-offset);
            right: 0;
        }
    }
</style>

<script>
    function init() {
        const $detailsList = document.querySelectorAll<HTMLDetailsElement>(
            ".info-reveal__details",
        );
        const openSound = new Audio(
            `${import.meta.env.BASE_URL}audio/old-camera-shutter-click-open.mp3`,
        );
        const closeSound = new Audio(
            `${import.meta.env.BASE_URL}audio/mouse-click-close.mp3`,
        );

        function isSoundOn() {
            const $soundToggle =
                document.querySelector<HTMLButtonElement>(".sound-toggle");
            return $soundToggle?.dataset.playing === "true";
        }

        function playSound(audio: HTMLAudioElement) {
            if (!isSoundOn()) return;
            audio.currentTime = 0;
            audio.play().catch(() => {});
        }

        $detailsList.forEach(($details) => {
            const $close = $details.querySelector<HTMLButtonElement>(
                ".info-reveal__close",
            );

            $details.addEventListener("toggle", () => {
                if ($details.open) {
                    playSound(openSound);
                }
            });

            $close?.addEventListener("click", (event) => {
                event.preventDefault();
                playSound(closeSound);
                $details.removeAttribute("open");
            });

            document.addEventListener("click", (event) => {
                const clickedInside = $details.contains(event.target as Node);
                if ($details.open && !clickedInside) {
                    playSound(closeSound);
                    $details.removeAttribute("open");
                }
            });
        });
    }

    init();
</script>

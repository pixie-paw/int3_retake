---
import { getImage } from "astro:assets";
import titleCh1Url from "../../assets/chapter1/title_ch1.svg?url";
import antwerpSrc from "../../assets/chapter1/antwerp_img.png";
import antwerpMobileSrc from "../../assets/chapter1/antwerp_mobile.png";
import paper02Src from "../../assets/chapter1/paper_02.png";
import tapeMovingALotUrl from "../../assets/chapter1/titleCh01_01.png?url";
import tapeWorldsUrl from "../../assets/chapter1/titleCh01_02.png?url";
import pinkFlowersSrc from "../../assets/chapter1/pink_flowers.png";
import tapeMotherUrl from "../../assets/chapter1/titleCh01_03.png?url";
import diarySrc from "../../assets/chapter1/diary.png";
import tapeFashionUrl from "../../assets/chapter1/titleCh01_04.png?url";
import tapeCombiningUrl from "../../assets/chapter1/titleCh01_05.png?url";
import eyeTestSrc from "../../assets/chapter1/eye_test_collage.png";
import laceLeftSrc from "../../assets/chapter1/lace_left.png";
import laceRightSrc from "../../assets/chapter1/lace_right.png";

const antwerp = await getImage({ src: antwerpSrc, format: "webp" });
const antwerpMobile = await getImage({ src: antwerpMobileSrc, format: "webp" });
const paper02 = await getImage({ src: paper02Src, format: "webp" });
const pinkFlowers = await getImage({ src: pinkFlowersSrc, format: "webp" });
const diary = await getImage({ src: diarySrc, format: "webp" });
const eyeTest = await getImage({ src: eyeTestSrc, format: "webp" });
const laceLeft = await getImage({ src: laceLeftSrc, format: "webp" });
const laceRight = await getImage({ src: laceRightSrc, format: "webp" });
---

<div class="chapter1">
    <img
        src={laceLeft.src}
        alt="Decorative lace stretching across the left side of the window."
        aria-hidden="true"
        class="chapter1__lace chapter1__lace--left"
    />
    <img
        src={laceRight.src}
        alt="Decorative lace stretching across the right side of the window."
        aria-hidden="true"
        class="chapter1__lace chapter1__lace--right"
    />

    <p class="chapter1__eyebrow">Chapter 1</p>

    <div class="chapter1__title-wrap" data-reveal>
        <img
            src={titleCh1Url}
            alt="Image that visually represents the title, reading 'Beginnings' in a decorative font and style."
            aria-hidden="true"
            class="chapter1__title-img"
        />
        <h2 class="visually-hidden">Beginnings</h2>
    </div>

    <div class="chapter1__hero" data-reveal>
        <section class="chapter1__block chapter1__block--moving">
            <div class="chapter1__label-wrap">
                <img
                    src={tapeMovingALotUrl}
                    alt="Image that visually represents the subtitle, reading 'Moving a lot' in a decorative font and style."
                    aria-hidden="true"
                    class="chapter1__label-img chapter1__label-img--moving"
                />
                <h3 class="visually-hidden">Moving a lot</h3>
            </div>

            <div
                class="chapter1__note"
                style={`--note-bg: url(${paper02.src})`}
            >
                <p>
                    Marina's childhood was marked by constant change. Before the
                    age of fifteen, her family had moved at least eleven times
                    across Belgium. Home was not always an easy place either;
                    her father's temper made the atmosphere unpredictable, and
                    friends rarely came over. Marina spent much of her time
                    alone, eventually describing herself as a "lone wolf".
                </p>
            </div>
        </section>

        <div
            class="chapter1__cityscape"
            style={`--cityscape-bg-mobile: url(${antwerpMobile.src}); --cityscape-bg-desktop: url(${antwerp.src})`}
        >
        </div>
    </div>

    <section class="chapter1__block chapter1__block--worlds" data-reveal>
        <img
            src={pinkFlowers.src}
            alt="Decorative pink flowers."
            aria-hidden="true"
            class="chapter1__flowers"
        />
        <div class="chapter1__label-wrap">
            <div>
                <img
                    src={tapeWorldsUrl}
                    alt="Image that visually represents the subtitle, reading 'Worlds of her own making' in a decorative font and style."
                    aria-hidden="true"
                    class="chapter1__label-img chapter1__label-img--worlds"
                />
                <h3 class="visually-hidden">Worlds of her own making</h3>
            </div>

            <p class="chapter1__paragraph">
                Spending so much time on her own taught her how to fill her days
                with small worlds of her own making. She wandered outside
                gathering wildflowers into bouquets, baked cakes at home and,
                eventually, began sewing. One interest seemed to lead naturally
                into another, as she found different ways to keep her hands and
                imagination occupied.
            </p>
        </div>

        <div class="chapter1__quote-wrap">
            <blockquote class="chapter1__quote">
                <span
                    class="chapter1__quote-mark chapter1__quote-mark--open"
                    aria-hidden="true">"</span
                >
                <p class="chapter1__quote-text">
                    She never related to other children, and became an odd,
                    dreamy, self-sufficient child, who entertained herself by
                    gathering bouquets of wild flowers, baking cakes, and,
                    eventually, sewing clothes.
                </p>
                <span
                    class="chapter1__quote-mark chapter1__quote-mark--close"
                    aria-hidden="true">"</span
                >
            </blockquote>
            <p class="chapter1__quote-attribution">— Avery Trufelman</p>
        </div>
    </section>

    <section class="chapter1__block chapter1__block--mother" data-reveal>
        <img
            src={diary.src}
            alt="Image that represents a diary, in a collage style, with a dried flower and surrouded by paper and some cloth."
            aria-hidden="true"
            class="chapter1__diary"
        />

        <div class="chapter1__mother-content">
            <div class="chapter1__label-wrap">
                <img
                    src={tapeMotherUrl}
                    alt="Image that visually represents the subtitle, reading 'Her mother, objects, and the past' in a decorative font and style."
                    aria-hidden="true"
                    class="chapter1__label-img chapter1__label-img--mother"
                />
                <h3 class="visually-hidden">
                    Her mother, objects, and the past
                </h3>
            </div>

            <p class="chapter1__paragraph">
                Her mother, later described by Marina as someone with great
                taste, opened up yet another world to her. She ran an antique
                shop, a place with old pieces of furniture, textiles and
                garments — objects that had already belonged somewhere, to
                someone, before finding their way into the shop. Surrounded by
                these materials and stories from the past, she taught Marina how
                to sew, giving her yet another way to experiment with what she
                was surrounded by.
            </p>
        </div>
    </section>

    <div class="chapter1__fashion-row" data-reveal>
        <img
            src={eyeTest.src}
            alt="A collage image composed of parts of Marina's own artwork, including a mannequin bust, a skirt created by her, a woman's head and a door full of posters, textures and a pannel just like the one eye doctors use when they test your eyesight."
            aria-hidden="true"
            class="chapter1__eye-test"
            data-magnify
        />

        <div class="chapter1__fashion-content">
            <section class="chapter1__block chapter1__block--fashion">
                <div class="chapter1__label-wrap">
                    <img
                        src={tapeFashionUrl}
                        alt="Image that visually represents the subtitle, reading 'Fashion for herself' in a decorative font and style."
                        aria-hidden="true"
                        class="chapter1__label-img chapter1__label-img--fashion"
                    />
                    <h3 class="visually-hidden">Fashion for herself</h3>
                </div>

                <p class="chapter1__paragraph">
                    As she became more comfortable with sewing, Marina began
                    using it to dress herself up. As a teenager, she made her
                    own high-waisted velvet skirts, later described as "a bit
                    gothic", and wore them with her mother's vintage boots from
                    Paris, combined with dark kohl around her eyes. Piece by
                    piece, she was developing a look that was distinctly her
                    own, built from handmade clothes, old finds and unusual
                    combinations.
                </p>
            </section>

            <section class="chapter1__block chapter1__block--combining">
                <div class="chapter1__label-wrap">
                    <img
                        src={tapeCombiningUrl}
                        alt="Image that visually represents the subtitle, reading 'Combining things' in a decorative font and style."
                        aria-hidden="true"
                        class="chapter1__label-img chapter1__label-img--combining"
                    />
                    <h3 class="visually-hidden">Combining things</h3>
                </div>

                <p class="chapter1__paragraph">
                    Marina's curiosity seemed to move freely from one thing to
                    another. She could be gathering flowers one moment, sewing
                    the next, or finding new ways to wear something old. She
                    experimented with whatever was around her, combining things
                    that interested her and letting one idea naturally lead to
                    another.
                </p>
            </section>

            <a
                href="https://www.momu.be/en/exhibitions/the-antwerp-six"
                target="_blank"
                rel="noopener noreferrer"
                class="chapter1__momu-link">Discover Marina's world at MoMu</a
            >
        </div>
    </div>
</div>

<style>
    .chapter1__lace {
        display: none;
    }

    .chapter1 {
        position: relative;
        padding: 4rem 1.5rem;
    }

    .chapter1__eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-family: var(--font-family-serif);
        font-weight: var(--weight-bold);
        color: var(--color-text-main);
        margin-bottom: 0.5rem;
    }

    .chapter1__title-img {
        display: block;
        width: 100%;
        max-width: 31rem;
        height: auto;
        margin-bottom: 2rem;
    }

    /* Moving section */
    .chapter1__title-wrap {
        position: relative;
        z-index: 3;
    }

    .chapter1__hero {
        position: relative;
    }

    .chapter1__block--moving {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
    }

    .chapter1__label-img {
        display: block;
        width: auto;
        height: auto;
    }

    .chapter1__label-img--moving {
        max-width: 14rem;
        z-index: 2;
        margin-left: -5rem;
        margin-bottom: 0.5rem;
    }

    .chapter1__note p {
        font-size: var(--step-0);
        color: var(--color-text-main);
        text-align: justify;
        max-width: 16rem;
    }

    .chapter1__cityscape {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        position: relative;
        aspect-ratio: 2204 / 2282;
        background-image: var(--cityscape-bg-mobile);
        background-size: cover;
        background-position: bottom center;
        background-repeat: no-repeat;
        margin-top: -14rem;
    }

    .chapter1__label-wrap {
        justify-content: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* Worlds section */
    .chapter1__block--worlds {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1.5rem;
        position: relative;
        margin-top: 3rem;
    }

    .chapter1__flowers {
        display: none;
    }

    .chapter1__label-img--worlds {
        max-width: 20rem;
        margin-bottom: 0.5rem;
    }

    .chapter1__paragraph {
        font-size: var(--step-0);
        color: var(--color-text-main);
        text-align: justify;
        max-width: 31rem;
    }

    .chapter1__quote-wrap {
        padding-top: 3rem;
        max-width: 63rem;
    }

    .chapter1__quote-mark {
        display: block;
        font-family: var(--font-family-punktype);
        font-weight: var(--weight-black, 900);
        font-size: 7rem;
        line-height: 1;
        color: var(--color-text-main);
        line-height: 0;
    }

    .chapter1__quote-mark--close {
        text-align: right;
        margin-top: 3.3rem;
    }

    .chapter1__quote-mark--open {
        text-align: left;
        margin-bottom: 1rem;
    }

    .chapter1__quote-text {
        font-family: var(--font-family-bestieseventy);
        font-size: var(--step-4);
        line-height: 2rem;
        color: var(--color-text-main);
        text-align: center;
        letter-spacing: 0.02em;
    }

    .chapter1__quote-attribution {
        text-align: right;
        font-family: var(--font-family-bestieseventy);
        font-size: var(--step-4);
        line-height: 2rem;
        color: var(--color-text-main);
        margin-top: 1.5rem;
    }

    /* Mother section */
    .chapter1__block--mother {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin-top: 3rem;
    }

    .chapter1__diary {
        display: block;
        width: 100%;
        max-width: 20rem;
        height: auto;
        margin-left: -4rem;
        margin-top: -4rem;
    }

    .chapter1__mother-content {
        display: flex;
        flex-direction: column;
    }

    .chapter1__label-img--mother {
        max-width: 20rem;
        margin-bottom: 0.5rem;
    }

    /* Fashion section */
    .chapter1__fashion-row {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin-top: 3rem;
    }

    .chapter1__eye-test {
        display: block;
        width: 100%;
        max-width: 25rem;
        height: auto;
        margin-inline: auto;
    }

    .chapter1__fashion-content {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    .chapter1__label-img--fashion {
        max-width: 20rem;
        margin-bottom: 0.5rem;
    }

    .chapter1__label-img--combining {
        max-width: 18rem;
        margin-bottom: 0.5rem;
    }

    .chapter1__momu-link {
        text-decoration: underline;
        font-family: var(--font-family-sans);
        color: var(--color-text-secondary);
        font-size: var(--step-2);
    }

    @media (min-width: 48rem) {
        /* Lace decoration */
        .chapter1__lace {
            display: block;
            position: absolute;
            width: auto;
            height: auto;
            object-fit: cover;
            pointer-events: none;
        }

        .chapter1__lace--left {
            left: 0%;
            top: 28%;
            bottom: 0;
            z-index: 0;
        }

        .chapter1__lace--right {
            right: 0%;
            top: 0rem;
            bottom: -10rem;
            z-index: 10;
        }

        /* Moving section */
        .chapter1 {
            padding-left: 3rem;
            padding-right: 3rem;
            padding-top: 6rem;
            margin-bottom: -4rem;
        }

        .chapter1__title-img {
            max-width: 61rem;
        }

        .chapter1__block--moving {
            position: absolute;
            top: 16vw;
            left: 15rem;
            max-width: 34rem;
        }

        .chapter1__label-img {
            margin-bottom: -2rem;
        }

        .chapter1__note p {
            background-image: var(--note-bg);
            background-size: 100% 100%;
            background-repeat: no-repeat;
            max-width: 41rem;
            padding-bottom: 6rem;
            padding-left: 3rem;
            padding-right: 3rem;
            padding-top: 3rem;
        }

        .chapter1__cityscape {
            aspect-ratio: 3746.93 / 2283;
            background-image: var(--cityscape-bg-desktop);
            top: -6vw;
        }

        /* Worlds section */
        .chapter1__block--worlds {
            position: relative;
            margin-left: 8rem;
            margin-top: 0;
        }

        .chapter1__flowers {
            display: block;
            position: absolute;
            top: -2rem;
            right: 4rem;
            width: 22rem;
            height: auto;
            object-fit: contain;
            pointer-events: none;
            z-index: -1;
        }

        .chapter1__label-img--worlds {
            margin-bottom: 1rem;
        }

        .chapter1__paragraph {
            padding-bottom: 1rem;
        }

        .chapter1__quote {
            max-width: 63rem;
        }

        .chapter1__quote-mark {
            font-size: 9rem;
        }

        .chapter1__quote-text {
            text-align: left;
            line-height: 3rem;
        }

        .chapter1__quote-attribution {
            line-height: 3rem;
            padding-top: 1rem;
        }

        /* Mother section */
        .chapter1__block--mother {
            flex-direction: row;
            align-items: flex-start;
            justify-content: center;
            margin-top: 8rem;
        }

        .chapter1__diary {
            max-width: 28rem;
            flex-shrink: 0;
            position: relative;
            top: -13rem;
            right: -6rem;
            margin-top: 0;
            margin-left: 0;
        }

        .chapter1__mother-content {
            flex: 1;
            max-width: 44rem;
            align-self: center;
            align-items: center;
        }

        .chapter1__label-img--mother {
            margin-bottom: 1rem;
        }

        /* Fashion section */
        .chapter1__fashion-row {
            display: flex;
            flex-direction: row-reverse;
            align-items: flex-start;
            margin-top: 5rem;
            margin-right: -3rem;
        }

        .chapter1__eye-test {
            order: initial;
            width: clamp(20rem, 45vw, 53rem);
            max-width: 53rem;
            margin-inline: 0;
            flex-shrink: 1;
            position: relative;
            top: -8rem;
        }

        .chapter1__fashion-content {
            order: initial;
            max-width: 30rem;
            min-width: 16rem;
            justify-content: center;
        }

        .chapter1__label-img--fashion,
        .chapter1__label-img--combining {
            margin-bottom: 1rem;
        }
    }
</style>

<script>
    import { initScrollReveal } from "../../scripts/scrollReveal";
    import { initMagnifier } from "../../scripts/Magnifier";

    initScrollReveal();
    initMagnifier();
</script>

---
import { getImage } from "astro:assets";
import titleCh1Url from "../../assets/chapter1/title_ch1.svg?url";
import antwerpSrc from "../../assets/chapter1/antwerp_img.png";
import antwerpMobileSrc from "../../assets/chapter1/antwerp_mobile.png";
import paper02Src from "../../assets/chapter1/paper_02.png";
import tapeMovingALotUrl from "../../assets/chapter1/titleCh01_01.png?url";
import tapeWorldsUrl from "../../assets/chapter1/titleCh01_02.png?url";
import pinkFlowersSrc from "../../assets/chapter1/pink_flowers.png";

const antwerp = await getImage({ src: antwerpSrc, format: "webp" });
const antwerpMobile = await getImage({ src: antwerpMobileSrc, format: "webp" });
const paper02 = await getImage({ src: paper02Src, format: "webp" });
const pinkFlowers = await getImage({ src: pinkFlowersSrc, format: "webp" });
---

<div class="chapter1">
    <p class="chapter1__eyebrow">Chapter 1</p>

    <div class="chapter1__title-wrap">
        <img
            src={titleCh1Url}
            alt=""
            aria-hidden="true"
            class="chapter1__title-img"
        />
        <h2 class="visually-hidden">Beginnings</h2>
    </div>

    <div class="chapter1__hero">
        <section class="chapter1__block chapter1__block--moving">
            <div class="chapter1__label-wrap">
                <img
                    src={tapeMovingALotUrl}
                    alt=""
                    aria-hidden="true"
                    class="chapter1__label-img"
                />
                <h3 class="visually-hidden">Moving a lot</h3>
            </div>

            <div
                class="chapter1__note"
                style={`--note-bg: url(${paper02.src})`}
            >
                <p>
                    Marina's childhood was marked by constant change. Before the
                    age of fifteen, her family had moved at least eleven times
                    across Belgium. Home was not always an easy place either;
                    her father's temper made the atmosphere unpredictable, and
                    friends rarely came over. Marina spent much of her time
                    alone, eventually describing herself as a "lone wolf".
                </p>
            </div>
        </section>

        <div
            class="chapter1__cityscape"
            style={`--cityscape-bg-mobile: url(${antwerpMobile.src}); --cityscape-bg-desktop: url(${antwerp.src})`}
        >
        </div>
    </div>

    <section class="chapter1__block chapter1__block--worlds">
        <img
            src={pinkFlowers.src}
            alt=""
            aria-hidden="true"
            class="chapter1__flowers"
        />

        <div class="chapter1__label-wrap">
            <img
                src={tapeWorldsUrl}
                alt=""
                aria-hidden="true"
                class="chapter1__label-img chapter1__label-img--worlds"
            />
            <h3 class="visually-hidden">Worlds of her own making</h3>
        </div>

        <p class="chapter1__paragraph">
            Spending so much time on her own taught her how to fill her days
            with small worlds of her own making. She wandered outside gathering
            wildflowers into bouquets, baked cakes at home and, eventually,
            began sewing. One interest seemed to lead naturally into another, as
            she found different ways to keep her hands and imagination occupied.
        </p>

        <div class="chapter1__quote-wrap">
            <blockquote class="chapter1__quote">
                <span
                    class="chapter1__quote-mark chapter1__quote-mark--open"
                    aria-hidden="true">"</span
                >
                <p class="chapter1__quote-text">
                    She never related to other children, and became an odd,
                    dreamy, self-sufficient child, who entertained herself by
                    gathering bouquets of wild flowers, baking cakes, and,
                    eventually, sewing clothes.
                </p>
                <span
                    class="chapter1__quote-mark chapter1__quote-mark--close"
                    aria-hidden="true">"</span
                >
            </blockquote>
            <p class="chapter1__quote-attribution">— Avery Trufelman</p>
        </div>
    </section>
</div>

<style>
    .chapter1 {
        position: relative;
        padding: 4rem 1.5rem;
    }

    .chapter1__eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-family: var(--font-family-serif);
        font-weight: var(--weight-bold);
        color: var(--color-text-main);
        margin-bottom: 0.5rem;
    }

    .chapter1__title-img {
        display: block;
        width: 100%;
        max-width: 500px;
        height: auto;
        margin-bottom: 2rem;
    }

    .chapter1__title-wrap {
        position: relative;
        z-index: 3;
    }

    .chapter1__hero {
        position: relative;
        /* overflow-x: clip; */
    }

    .chapter1__block {
        position: relative;
        z-index: 2;
    }

    .chapter1__block--moving {
        left: 2rem;
    }

    .chapter1__label-img {
        display: block;
        width: auto;
        height: auto;
        max-width: 220px;
    }

    .chapter1__note p {
        font-size: var(--step-0);
        color: var(--color-text-main);
        text-align: justify;
        max-width: 213px;
    }

    .chapter1__cityscape {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        position: relative;
        aspect-ratio: 2204 / 2282;
        background-image: var(--cityscape-bg-mobile);
        background-size: cover;
        background-position: bottom center;
        background-repeat: no-repeat;
        margin-top: -14rem;
    }

    .chapter1__block--worlds {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        position: relative;
        margin-top: 3rem;
    }

    .chapter1__flowers {
        display: none;
    }

    .chapter1__label-img--worlds {
        max-width: 360px;
    }

    .chapter1__paragraph {
        font-size: var(--step-0);
        color: var(--color-text-main);
        text-align: justify;
        max-width: 500px;
    }

    .chapter1__quote-wrap {
        padding-top: 3rem;
        max-width: 1001.46px;
    }

    .chapter1__quote-mark {
        display: block;
        font-family: var(--font-family-punktype);
        font-weight: var(--weight-black, 900);
        font-size: 7rem;
        line-height: 1;
        color: var(--color-text-main);
        line-height: 0;
    }

    .chapter1__quote-mark--close {
        text-align: right;
        margin-top: 3.3rem;
    }

    .chapter1__quote-mark--open {
        text-align: left;
        margin-bottom: 1rem;
    }

    .chapter1__quote-text {
        font-family: var(--font-family-bestieseventy);
        font-size: var(--step-4);
        line-height: 2rem;
        color: var(--color-text-main);
        text-align: center;
        letter-spacing: 0.02em;
    }

    .chapter1__quote-attribution {
        text-align: right;
        font-family: var(--font-family-bestieseventy);
        font-size: var(--step-4);
        line-height: 2rem;
        color: var(--color-text-main);
        margin-top: 1.5rem;
    }

    @media (min-width: 768px) {
        .chapter1 {
            padding: 10rem 3rem;
        }

        .chapter1__title-img {
            max-width: 979.63px;
        }

        .chapter1__block--moving {
            position: absolute;
            top: 16vw;
            left: 15rem;
            max-width: 550px;
        }

        .chapter1__label-img {
            margin-bottom: -2rem;
            margin-left: 3rem;
        }

        .chapter1__note p {
            background-image: var(--note-bg);
            background-size: 100% 100%;
            background-repeat: no-repeat;
            max-width: 657.8px;
            padding-bottom: 6rem;
            padding-left: 3rem;
            padding-right: 3rem;
            padding-top: 3rem;
        }

        .chapter1__cityscape {
            aspect-ratio: 3746.93 / 2283;
            background-image: var(--cityscape-bg-desktop);
            top: -6vw;
        }

        .chapter1__block--worlds {
            position: relative;
            margin-left: 8rem;
        }

        .chapter1__flowers {
            display: block;
            position: absolute;
            top: -2rem;
            right: 4rem;
            width: 346.67px;
            height: auto;
            object-fit: contain;
            pointer-events: none;
            z-index: -1;
        }

        .chapter1__paragraph {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }

        .chapter1__quote {
            max-width: 1001.46px;
        }

        .chapter1__quote-mark {
            font-size: 9rem;
        }

        .chapter1__quote-text {
            text-align: left;
            line-height: 3rem;
        }

        .chapter1__quote-attribution {
            line-height: 3rem;
            padding-top: 1rem;
        }
    }
</style>

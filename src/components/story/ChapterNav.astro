---
// src/components/story/ChapterNav.astro
import { chapters } from "../../data/chapters";

const currentPath = Astro.url.pathname;
---

<nav class="chapter-nav" aria-label="Story chapters">
    <ul class="chapter-nav__list">
        {
            chapters.map((chapter) => (
                <li>
                    <a
                        href={`#${chapter.id}`}
                        class="chapter-nav__link"
                        data-chapter-link={chapter.id}
                    >
                        {chapter.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<style>
    .chapter-nav {
        position: sticky;
        top: calc(var(--nav-height) - 2.5px);
        z-index: 15;
        scroll-margin-top: var(--nav-height);
        border-top: 2.5px solid var(--color-text-secondary, black);
        border-bottom: 2.5px solid var(--color-text-secondary, black);
        background: var(--color-bg, white);
    }

    .chapter-nav__list {
        display: flex;
        list-style: none;
        justify-content: center;
        flex-wrap: wrap;
    }

    .chapter-nav__link {
        display: block;
        padding: 1.5rem 0.55rem;
        text-decoration: none;
        color: inherit;
        font-family: var(--font-family-serif);
        font-size: var(--step--2);
        white-space: nowrap;
    }

    .chapter-nav__link[aria-current="page"] {
        font-weight: var(--weight-bold);
        background: var(--color-text-secondary, black);
        color: var(--color-bg, white);
        text-decoration: underline;
    }

    @media (min-width: 768px) {
        .chapter-nav__link {
            padding: 1rem 1.5rem;
        }

        .chapter-nav__link:hover {
            text-decoration: underline;
            background: var(--color-pink, pink);
        }
    }
</style>

<script>
    function init() {
        const $links = document.querySelectorAll<HTMLAnchorElement>(
            "[data-chapter-link]",
        );

        const $sections = Array.from($links)
            .map(($link) =>
                document.getElementById($link.dataset.chapterLink ?? ""),
            )
            .filter((el): el is HTMLElement => el !== null);

        if ($sections.length === 0) return;

        const setActive = (id: string) => {
            $links.forEach(($link) => {
                if ($link.dataset.chapterLink === id) {
                    $link.setAttribute("aria-current", "page");
                } else {
                    $link.removeAttribute("aria-current");
                }
            });
        };

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        setActive(entry.target.id);
                    }
                });
            },
            { rootMargin: "-45% 0px -45% 0px", threshold: 0 },
        );

        $sections.forEach(($section) => observer.observe($section));
        setActive($sections[0].id);
    }

    init();
</script>

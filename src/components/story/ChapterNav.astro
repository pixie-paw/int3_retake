---
// src/components/story/ChapterNav.astro
import { chapters } from "../../data/chapters";

const currentPath = Astro.url.pathname;
---

<nav class="chapter-nav" id="chapter-nav" aria-label="Story chapters">
    <ul class="chapter-nav__list">
        {
            chapters.map((chapter) => {
                const isActive = currentPath === chapter.href;
                return (
                    <li>
                        <a
                            href={`${chapter.href}#chapter-nav`}
                            class="chapter-nav__link"
                            aria-current={isActive ? "page" : undefined}
                        >
                            {chapter.label}
                        </a>
                    </li>
                );
            })
        }
    </ul>
</nav>

<style>
    .chapter-nav {
        scroll-margin-top: var(--nav-height);
        border-top: 2.5px solid var(--color-text-secondary, black);
        border-bottom: 2.5px solid var(--color-text-secondary, black);
        background: var(--color-bg, white);
    }

    .chapter-nav__list {
        display: flex;
        list-style: none;
        justify-content: center;
        flex-wrap: wrap;
    }

    .chapter-nav__link {
        display: block;
        padding: 1.5rem 0.55rem;
        text-decoration: none;
        color: inherit;
        font-family: var(--font-family-serif);
        font-size: var(--step--2);
        white-space: nowrap;
    }

    .chapter-nav__link[aria-current="page"] {
        font-weight: var(--weight-bold);
        background: var(--color-text-secondary, black);
        color: var(--color-bg, white);
        text-decoration: underline;
    }

    @media (min-width: 768px) {
        .chapter-nav__link {
            padding: 1rem 1.5rem;
        }

        .chapter-nav__link:hover {
            text-decoration: underline;
            background: var(--color-pink, pink);
        }
    }
</style>

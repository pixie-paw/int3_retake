---
interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "An interactive scrollytelling story about Marina Yee, for MoMu Antwerp.",
} = Astro.props;
---

<meta name="description" content={description} />
<link
    rel="icon"
    href={`${import.meta.env.BASE_URL}momu_logo.svg`}
    type="image/svg+xml"
/>
<link rel="preconnect" href="https://use.typekit.net" crossorigin />
<link rel="stylesheet" href="https://use.typekit.net/wnq3ntm.css" />

<title>{title}</title>

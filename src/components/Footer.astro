---
import arrowSendUrl from "../assets/footer/arrow_send.svg?url";
import validIconUrl from "../assets/footer/valid_icon.svg?url";
import invalidIconUrl from "../assets/footer/invalid_icon.svg?url";
import nextArrowUrl from "../assets/footer/next_arrow.svg?url";
import { getImage } from "astro:assets";
import laceLeftSrc from "../assets/footer/lace_left.png";
import momuInviteUrl from "../assets/footer/momu_invite.svg?url";

const laceLeft = await getImage({ src: laceLeftSrc, format: "webp" });
---

<footer class="footer">
    <img
        src={laceLeft.src}
        alt=""
        aria-hidden="true"
        class="footer__lace footer__lace--left"
    />

    <section class="footer__share">
        <h2 class="footer__share-heading">
            Share this story with someone you'd like to visit
        </h2>
        <p class="footer__share-text">
            Give them a little context on Marina's life and work before you
            experience it together at MoMu.
        </p>

        <form class="footer__email-form" novalidate>
            <label for="share-email" class="footer__email-label">
                Type the person's email in the field below
            </label>

            <input
                type="email"
                id="share-email"
                name="email"
                class="footer__email-input"
                placeholder="Email"
                required
            />
            <button
                type="submit"
                class="footer__email-submit"
                aria-label="Share"
            >
                <img src={arrowSendUrl} alt="" aria-hidden="true" />
            </button>

            <p class="footer__email-feedback footer__email-feedback--valid">
                <img src={validIconUrl} alt="" aria-hidden="true" />
                This email address is correct.
            </p>
            <p class="footer__email-feedback footer__email-feedback--invalid">
                <img src={invalidIconUrl} alt="" aria-hidden="true" />
                This email address is invalid.
            </p>
        </form>
    </section>

    <div class="footer__divider"></div>

    <!-- TODO: not real content yet — linking to MoMu's own page about
         Walter van Beirendonck as a placeholder "next story" destination
         until an actual next story exists. -->
    <a
        href="https://www.momu.be/en/designers/walter-van-beirendonck"
        target="_blank"
        rel="noopener noreferrer"
        class="footer__next-story"
        aria-label="Next story: Walter van Beirendonck"
    >
        <span aria-hidden="true">
            Next story<span class="footer__next-story-name"
                >: Walter van Beirendonck</span
            >
        </span>
        <img
            src={nextArrowUrl}
            alt=""
            aria-hidden="true"
            class="footer__next-arrow"
        />
    </a>

    <div class="footer__divider"></div>

    <div class="footer__bottom">
        <section class="footer__invite">
            <img
                src={momuInviteUrl}
                alt=""
                aria-hidden="true"
                class="footer__invite-title"
            />
            <h2 class="visually-hidden">MoMu invite</h2>

            <p class="footer__invite-text">
                The journey doesn't end here. MoMu invites you to step inside
                Marina's world and atelier yourself.
            </p>
            <p class="footer__invite-text">
                A large part of her living and working space has been
                reconstructed for the Antwerp Six exhibition. This brings
                together garments, drawings, objects and materials that
                surrounded her as she created, plus a chance to learn even more
                about the entire group, each member having their own
                installation.
            </p>

            <a
                href="https://www.momu.be/en/exhibitions/the-antwerp-six"
                target="_blank"
                rel="noopener noreferrer"
                class="footer__cta"
            >
                Visit Museum
            </a>
        </section>

        <div class="footer__vdivider"></div>

        <section class="footer__newsletter">
            <h2 class="footer__newsletter-heading">Never miss a story</h2>
            <p class="footer__newsletter-text">
                By subscribe to our newsletter, we will notify you as soon as
                another story comes out - no spam, just creativity.
            </p>

            <form class="footer__email-form" novalidate>
                <label for="newsletter-email" class="footer__email-label">
                    Type your e-mail in the field below
                </label>

                <input
                    type="email"
                    id="newsletter-email"
                    name="email"
                    class="footer__email-input"
                    placeholder="Subscribe to our mailing list"
                    required
                />
                <button
                    type="submit"
                    class="footer__email-submit"
                    aria-label="Subscribe"
                >
                    <img src={arrowSendUrl} alt="" aria-hidden="true" />
                </button>

                <p class="footer__email-feedback footer__email-feedback--valid">
                    <img src={validIconUrl} alt="" aria-hidden="true" />
                    This email address is correct.
                </p>
                <p
                    class="footer__email-feedback footer__email-feedback--invalid"
                >
                    <img src={invalidIconUrl} alt="" aria-hidden="true" />
                    This email address is invalid.
                </p>
            </form>

            <h3 class="footer__follow-heading">Follow MoMu on:</h3>
            <div class="footer__social">
                <a
                    href="https://www.facebook.com/momuantwerp"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="footer__social-link"
                    aria-label="Facebook"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="50"
                        height="50"
                        viewBox="0 0 50 50"
                        id="facebook"
                        ><title>Facebook</title>
                        <path
                            d="M50,25A25,25,0,1,0,24.44,50V30.2H18.75V24h5.69V17.7c0-5,3-8.3,9-8.3A22.89,22.89,0,0,1,38,9.81v5.82H34c-1.83,0-2.73,1-2.73,2.83V24H37.5l-.9,6.25H31.25v19A25,25,0,0,0,50,25Z"
                        ></path>
                    </svg>
                </a>
                <a
                    href="https://www.instagram.com/momuantwerp"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="footer__social-link"
                    aria-label="Instagram"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="50"
                        height="50"
                        viewBox="0 0 50 50"
                        ><title>Instagram</title>
                        <path
                            d="M25,0A25,25,0,1,0,50,25,25,25,0,0,0,25,0ZM39.47,31.09a10.42,10.42,0,0,1-.66,3.44,7.31,7.31,0,0,1-4.15,4.15,10.54,10.54,0,0,1-3.45.66c-1.51.07-2,.09-5.85.09s-4.34,0-5.85-.09a10.54,10.54,0,0,1-3.45-.66A6.94,6.94,0,0,1,13.55,37a6.86,6.86,0,0,1-1.64-2.51,10.42,10.42,0,0,1-.66-3.44c-.07-1.52-.08-2-.08-5.86s0-4.33.08-5.85a10.42,10.42,0,0,1,.66-3.44,7.23,7.23,0,0,1,4.15-4.15,10.54,10.54,0,0,1,3.45-.66c1.51-.07,2-.09,5.85-.09s4.34,0,5.85.09a10.54,10.54,0,0,1,3.45.66,6.91,6.91,0,0,1,2.51,1.63,7,7,0,0,1,1.64,2.52,10.42,10.42,0,0,1,.66,3.44c.07,1.52.08,2,.08,5.85S39.54,29.57,39.47,31.09Z"
                        ></path>
                        <circle cx="25.35" cy="25.2" r="4.73"></circle>
                        <path
                            d="M36.91,19.5a7.68,7.68,0,0,0-.49-2.64,4.3,4.3,0,0,0-1.06-1.63,4.47,4.47,0,0,0-1.63-1.06,7.87,7.87,0,0,0-2.64-.49c-1.49-.07-1.94-.08-5.73-.08s-4.24,0-5.74.08a7.86,7.86,0,0,0-2.63.49,4.47,4.47,0,0,0-1.63,1.06,4.3,4.3,0,0,0-1.06,1.63,7.68,7.68,0,0,0-.49,2.64c-.07,1.5-.09,1.94-.09,5.73s0,4.24.09,5.74a7.6,7.6,0,0,0,.49,2.63,4.26,4.26,0,0,0,1.06,1.64A4.47,4.47,0,0,0,17,36.3a8.13,8.13,0,0,0,2.63.49c1.5.07,1.95.08,5.74.08s4.24,0,5.73-.08a8.14,8.14,0,0,0,2.64-.49,4.47,4.47,0,0,0,1.63-1.06,4.26,4.26,0,0,0,1.06-1.64A7.6,7.6,0,0,0,36.91,31C37,29.47,37,29,37,25.23S37,21,36.91,19.5Zm-11.56,13a7.29,7.29,0,1,1,7.29-7.29A7.29,7.29,0,0,1,25.35,32.49Zm7.58-13a1.71,1.71,0,1,1,1.71-1.7A1.7,1.7,0,0,1,32.93,19.45Z"
                        ></path>
                    </svg>
                </a>
                <a
                    href="https://www.linkedin.com/company/momuantwerp/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="footer__social-link"
                    aria-label="LinkedIn"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="50"
                        height="50"
                        viewBox="0 0 50 50"
                        ><title>Linkedin</title>
                        <path
                            d="M25,0A25,25,0,1,0,50,25,25,25,0,0,0,25,0ZM17.7,37.5H11.45V19.8H17.7ZM14.58,16.67h-.05C12,16.67,10.42,15,10.42,13s1.66-3.63,4.16-3.63S18.7,10.94,18.75,13,17.14,16.67,14.58,16.67ZM40.63,37.5H34.38V28.13C34.38,25,33.11,24,31.2,24s-3.07,1.64-3.07,4.18V37.5H21.88V24s-.13-3.47-.18-4.15h6.21l.22,2.71a5.36,5.36,0,0,1,5.2-3.76c4.46,0,7.3,3.64,7.3,9.38Z"
                        ></path>
                    </svg>
                </a>
                <a
                    href="https://www.pinterest.com/momuantwerp"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="footer__social-link"
                    aria-label="Pinterest"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="50"
                        height="50"
                        viewBox="0 0 50 50"
                        ><title>Pinterest</title>
                        <path
                            d="M50,25A25,25,0,1,0,15,47.92a19.08,19.08,0,0,1,.42-5.73c.43-2.08,3.22-13.65,3.22-13.65a9.28,9.28,0,0,1-.81-3.95c0-3.69,2.15-6.47,4.81-6.47,2.25,0,3.35,1.68,3.35,3.76,0,2.24-1.44,5.66-2.2,8.86a3.84,3.84,0,0,0,3.93,4.78c4.76,0,7.93-6.05,7.93-13.23,0-5.52-3.63-9.62-10.35-9.62A11.87,11.87,0,0,0,13,24.66a7.4,7.4,0,0,0,1.62,4.91c.46.53.58.75.41,1.39-.12.46-.41,1.56-.51,2a.92.92,0,0,1-1.3.64C9.72,32.18,8.11,28.34,8.11,24c0-7.13,6-15.62,17.87-15.62,9.49,0,15.79,6.93,15.79,14.35,0,9.77-5.42,17.12-13.47,17.12-2.71,0-5.28-1.44-6.13-3.13,0,0-1.44,5.79-1.74,6.89A19.43,19.43,0,0,1,17.87,49,23.71,23.71,0,0,0,25,50,25,25,0,0,0,50,25Z"
                        ></path>
                    </svg>
                </a>
            </div>

            <div class="footer__address">
                <img
                    src={`${import.meta.env.BASE_URL}momu_logo.svg`}
                    alt="MoMu"
                    class="footer__logo"
                />
                <address class="footer__address-text">
                    Nationalestraat 28<br />
                    2000 Antwerp
                </address>
            </div>
        </section>
    </div>
</footer>

<style>
    .footer {
        position: relative;
        padding: 4rem 1.5rem;
        border-top: 2.5px solid var(--color-text-secondary, black);
        background: var(--color-bg, white);
        margin-top: 5rem;
    }

    .footer__lace {
        display: none;
    }

    .footer__share {
        text-align: center;
    }

    .footer__share-heading {
        font-family: var(--font-family-serif);
        font-weight: var(--weight-bold);
        font-size: var(--step-2);
        color: var(--color-text-main);
        margin-bottom: 0.75rem;
    }

    .footer__share-text {
        font-family: var(--font-family-sans);
        font-size: var(--step-0);
        color: var(--color-text-main);
        max-width: 24rem;
        margin-inline: auto;
        margin-bottom: 1.5rem;
    }

    .footer__email-form {
        display: flex;
        flex-wrap: wrap;
        max-width: 24rem;
        margin-inline: auto;
        text-align: left;
    }

    .footer__email-label {
        flex-basis: 100%;
        display: block;
        font-family: var(--font-family-sans);
        font-size: var(--step-6);
        color: var(--color-text-secondary);
        margin-bottom: 0.5rem;
    }

    .footer__email-input {
        flex: 1 1 auto;
        min-width: 0;
        border: 2.5px solid var(--color-text-secondary, black);
        border-right: none;
        background: none;
        padding: 0.75rem 1rem;
        font-family: var(--font-family-sans);
        font-size: var(--step-0);
        color: var(--color-text-main);
    }

    .footer__email-input::placeholder {
        color: var(--color-text-secondary);
        opacity: 0.6;
    }

    .footer__email-input:focus {
        outline: none;
    }

    .footer__email-submit {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 3.5rem;
        border: 2.5px solid var(--color-text-secondary, black);
        background: var(--color-text-secondary, black);
        cursor: pointer;
    }

    .footer__email-submit img {
        width: 1.25rem;
        height: auto;
    }

    /* --- JS-free validation feedback --- */
    .footer__email-feedback {
        flex-basis: 100%;
        display: none;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-family-sans);
        font-size: var(--step-6);
        margin-top: 0.5rem;
    }

    .footer__email-feedback img {
        width: 1rem;
        height: auto;
        flex-shrink: 0;
    }

    .footer__email-input:invalid:not(:placeholder-shown)
        ~ .footer__email-feedback--invalid {
        display: flex;
    }

    .footer__email-input:valid:not(:placeholder-shown)
        ~ .footer__email-feedback--valid {
        display: flex;
    }

    .footer__divider {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        border-top: 2.5px solid var(--color-text-secondary, black);
        margin-block: 2.5rem;
    }

    .footer__next-story {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 1rem;
        font-family: var(--font-family-serif);
        font-size: var(--step-1);
        font-weight: var(--weight-bold);
        text-decoration: underline;
        color: var(--color-text-main);
    }

    .footer__next-arrow {
        width: 3rem;
        height: auto;
        flex-shrink: 0;
    }

    .footer__next-story-name {
        display: none;
    }

    .footer__bottom {
        display: flex;
        flex-direction: column;
    }

    .footer__invite-title {
        display: block;
        width: 100%;
        max-width: 16rem;
        height: auto;
        margin-bottom: 1.5rem;
    }

    .footer__invite-text {
        font-family: var(--font-family-sans);
        font-size: var(--step-0);
        color: var(--color-text-main);
        margin-bottom: 1rem;
    }

    .footer__cta {
        display: inline-block;
        background: var(--color-text-secondary, black);
        color: var(--color-bg, white);
        font-family: var(--font-family-sans);
        font-weight: var(--weight-medium);
        text-decoration: none;
        padding: 0.75rem 1.5rem;
        margin-top: 1rem;
    }

    .footer__vdivider {
        border-top: 2.5px solid var(--color-text-secondary, black);
        margin-block: 2.5rem;
    }

    .footer__newsletter-heading {
        font-family: var(--font-family-serif);
        font-weight: var(--weight-bold);
        font-size: var(--step-2);
        color: var(--color-text-main);
        margin-bottom: 0.5rem;
    }

    .footer__newsletter-text {
        font-family: var(--font-family-sans);
        font-size: var(--step-0);
        color: var(--color-text-main);
        max-width: 26rem;
        margin-bottom: 1.5rem;
    }

    .footer__follow-heading {
        font-family: var(--font-family-serif);
        font-weight: var(--weight-bold);
        font-size: var(--step-1);
        color: var(--color-text-main);
        margin-top: 2rem;
        margin-bottom: 1rem;
    }

    .footer__social {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 2.5rem;
    }

    .footer__social-link svg {
        width: 2.2rem;
        height: auto;
        fill: var(--color-text-secondary, black);
    }

    .footer__address {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .footer__logo {
        width: 5rem;
        height: auto;
    }

    .footer__address-text {
        font-family: var(--font-family-sans);
        font-style: normal;
        font-size: var(--step-0);
        color: var(--color-text-main);
        line-height: 1.5;
    }

    @media (min-width: 48rem) {
        .footer {
            padding: 4rem 6rem;
            margin-top: 10rem;
        }

        .footer__lace {
            display: block;
            position: absolute;
            left: 0;
            top: 0;
            height: auto;
            object-fit: contain;
            pointer-events: none;
        }

        .footer__next-story-name {
            display: inline;
        }

        .footer__bottom {
            flex-direction: row;
            align-items: flex-start;
        }

        .footer__invite,
        .footer__newsletter {
            flex: 1 1 0;
        }

        .footer__vdivider {
            width: 0;
            border-top: none;
            border-left: 2.5px solid var(--color-text-secondary, black);
            margin-block: 0;
            margin-inline: 3rem;
            align-self: stretch;
        }

        .footer__invite-title {
            max-width: 24rem;
        }

        .footer__cta {
            border: 2.5px solid var(--color-text-secondary, black);
        }

        .footer__cta:hover {
            background: var(--color-pink, pink);
            color: var(--color-text-secondary, black);
        }
    }
</style>

<script>
    // Progressive enhancement only — the form has no backend yet, so this
    // just stops a raw GET-to-self page reload on submit. Native
    // type="email" + required validation, and the CSS :has() feedback
    // above, both work identically with this script absent.
    function init() {
        const $forms = document.querySelectorAll<HTMLFormElement>(
            ".footer__email-form",
        );

        $forms.forEach(($form) => {
            $form.addEventListener("submit", (event) => {
                event.preventDefault();
            });
        });
    }

    init();
</script>
